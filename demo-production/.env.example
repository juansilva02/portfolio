ERP_ROOT=F:/Proyectos/zuzudev-erp
GOOGLE_OAUTH_FILE=C:/path/to/google-client.json
# Set the API release tag or digest before enabling provisioning.
API_IMAGE=registry.example.invalid/zuzudev-api:release
DEMO_FRONTEND_MODE=vercel
DEMO_GATEWAY_SECRET=
MAX_DEMOS=2
