{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "demo.zuzudev.pro" }], "destination": "/demo", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/demo/config", "has": [{ "type": "host", "value": "demo.zuzudev.pro" }], "destination": "https://auth-demos.zuzudev.pro/api/demo/config" },
    { "source": "/api/demo/status", "has": [{ "type": "host", "value": "demo.zuzudev.pro" }], "destination": "https://auth-demos.zuzudev.pro/api/demo/status" },
    { "source": "/api/demo/start", "has": [{ "type": "host", "value": "demo.zuzudev.pro" }], "destination": "https://auth-demos.zuzudev.pro/api/demo/start" },
    { "source": "/api/demo/login", "has": [{ "type": "host", "value": "demo.zuzudev.pro" }], "destination": "https://auth-demos.zuzudev.pro/api/demo/login" },
    { "source": "/auth/authorize", "has": [{ "type": "host", "value": "demo.zuzudev.pro" }], "destination": "https://auth-demos.zuzudev.pro/auth/authorize" },
    { "source": "/auth/signup/callback/google", "has": [{ "type": "host", "value": "demo.zuzudev.pro" }], "destination": "https://auth-demos.zuzudev.pro/auth/signup/callback/google" },
    { "source": "/demo/d-:slug([a-z0-9-]+)/d-:id([a-f0-9]{32})", "has": [{ "type": "host", "value": "demo.zuzudev.pro" }], "destination": "https://auth-demos.zuzudev.pro/demo/d-:slug/d-:id" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
